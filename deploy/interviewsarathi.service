# /etc/systemd/system/interviewsarathi.service
# Enable:  systemctl enable interviewsarathi
# Start:   systemctl start  interviewsarathi
# Logs:    journalctl -u interviewsarathi -f

[Unit]
Description=Interview Sarathi FastAPI Backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/interviewsarathi/backend
Environment="ENV=production"
EnvironmentFile=/var/www/interviewsarathi/backend/.env
ExecStart=/var/www/interviewsarathi/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --log-level info \
    --access-log
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
