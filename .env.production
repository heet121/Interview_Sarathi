# ═══════════════════════════════════════════════════════
# Interview Sarathi — PRODUCTION Environment Variables
# Copy to /var/www/interviewsarathi/backend/.env
# NEVER commit this file to git
# ═══════════════════════════════════════════════════════

# ── Database (PostgreSQL on IONOS) ────────────────────
DATABASE_URL=postgresql://sarathi_user:STRONG_PASSWORD@localhost:5432/sarathi_db

# ── Security ──────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── Whisper STT ───────────────────────────────────────
WHISPER_MODE=local
WHISPER_LOCAL_MODEL=base

# ── Storage ───────────────────────────────────────────
UPLOAD_DIR=/var/www/interviewsarathi/uploads
DATASET_DIR=/var/www/interviewsarathi/dataset
MAX_UPLOAD_MB=10

# ── Frontend (your actual domain) ────────────────────
FRONTEND_URL=https://yourdomain.com

# ── CORS ─────────────────────────────────────────────
# (also update allow_origins in main.py to your domain)

# ── Email (IONOS SMTP) ────────────────────────────────
# IONOS webmail SMTP: smtp.ionos.com port 587
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your-ionos-email-password
EMAIL_FROM=noreply@yourdomain.com

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute

# ── Google OAuth ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/oauth/google/callback

# ── GitHub OAuth ─────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://yourdomain.com/api/auth/oauth/github/callback

# ── Admin Panel ──────────────────────────────────────
ADMIN_SECRET_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING
